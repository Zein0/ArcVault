# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Switch between "openai" and "ollama" — zero code changes needed
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# ─── Pipeline ─────────────────────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.70
OUTPUT_DIR=output
LOG_LEVEL=INFO
